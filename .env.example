# ── Backend selector ─────────────────────────────────────────────────────────
# "ollama"  →  use local Ollama server  (default)
# "vllm"    →  use vLLM GPU server
AGENT_BACKEND=ollama

# ── Ollama (used when AGENT_BACKEND=ollama) ───────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b

# ── vLLM  (used when AGENT_BACKEND=vllm) ─────────────────────────────────────
VLLM_URL=http://YOUR_GPU_SERVER_IP:8000
VLLM_MODEL=Qwen/CodeQwen1.5-7B-Chat
VLLM_API_KEY=EMPTY           

# ── Agent behaviour ───────────────────────────────────────────────────────────
AGENT_TIMEOUT=300
AUTO_GIT_BACKUP=false
MAX_FILE_KB=100
MAX_CONTEXT_CHARS=3000

# ── REST Server ───────────────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_API_KEY=
